    <string name="set_sec_tiles">MAP TILES</string>
    <string name="set_tiles_text">By default the map uses the public OpenStreetMap tile server, which is meant for light use. For heavy use, enter your own or a commercial tile server that allows it.</string>
    <string name="set_tile_label">Tile URL (optional)</string>
    <string name="set_tile_support">Example: https://tiles.example.org/{z}/{x}/{y}.png. Leave empty for the default.</string>
    <string name="set_sec_storage">STORAGE</string>
    <string name="set_storage_text">Clearing the cache removes downloaded repeater data, cached propagation values and saved map tiles. The bundled data is restored. Favorites and settings are kept.</string>
